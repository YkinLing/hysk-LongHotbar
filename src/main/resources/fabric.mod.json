{
	"schemaVersion": 1,
	"id": "longhotbar",
	"version": "${version}",
	"name": "LongHotbar",
	"description": "LongHotbar The dual-column side-by-side quick bar enables you to quickly access more items in your backpack and offers a flexible item exchange mechanism.",
	"authors": ["倾杺恒跃时空-YkinLing"],
	"contact": {
		"homepage": "https://modrinth.com/mod/hysk-longhotbar"
	},
	"license": "BSD 2",
	"icon": "assets/longhotbar/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"hysk.longhotbar.LongHotbar"
		],
		"client": [
			"hysk.longhotbar.LongHotbarClient"
		],
		"modmenu": [
			"hysk.longhotbar.LongHotbarModMenuIntegration"
		]
	},
	"mixins": [
		"longhotbar.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}